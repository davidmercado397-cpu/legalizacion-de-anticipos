# Copie este archivo como .env (cp .env.example .env) y ajuste lo que necesite. Todo es opcional en
# desarrollo: docker-compose.yml trae valores por defecto. .env NUNCA se sube al repositorio.
# La configuración completa de la API (WhatsApp, R2, roles de BD…) está en apps/api/.env.example.

# Lectura de facturas con IA (OpenRouter). Vacío = la API responde 503 al leer y se digita a mano.
OPENROUTER_API_KEY=

# Roles que deben activar la verificación en dos pasos (en producción: admin,accountant,superadmin).
MFA_REQUIRED_ROLES=superadmin

# Puertos en su equipo (cámbielos si ya están ocupados)
WEB_PORT=5173
DB_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
