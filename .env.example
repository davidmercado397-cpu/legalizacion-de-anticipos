# Copie este archivo como .env (cp .env.example .env) y ajuste los valores.
# .env NUNCA se sube al repositorio.

# ---------- Base de datos (contenedor "db") ----------
POSTGRES_DB=viaticos
POSTGRES_USER=viaticos
POSTGRES_PASSWORD=viaticos_local
# Puerto expuesto en su equipo (cámbielo si ya usa 5432)
DB_PORT=5432

# ---------- API ----------
# En Docker la API no publica puerto: úsela vía http://localhost:5173/api/v1

# Lectura automática de facturas:
#   manual  = el viajero digita los datos (por defecto, no requiere nada)
#   claude  = lectura con IA; requiere una API key de https://console.anthropic.com
OCR_PROVEEDOR=manual
ANTHROPIC_API_KEY=
# Esfuerzo de lectura: low | medium | high (más alto = más preciso y más costoso)
OCR_ESFUERZO=medium
# memoria = sin base de datos (datos de prueba en RAM) | postgres
PERSISTENCIA=postgres
# Desde su equipo (pnpm dev:api). Dentro de Docker compose usa el host "db".
DATABASE_URL=postgres://viaticos:viaticos_local@localhost:5432/viaticos
# Base para las pruebas de integración (pnpm test:integracion); se crea sola con el contenedor db
TEST_DATABASE_URL=postgres://viaticos:viaticos_local@localhost:5432/viaticos_test
# jwt = login real | dev = cabecera x-usuario-id (solo desarrollo, prohibido en producción)
AUTH_MODE=jwt
# Secreto para firmar los tokens (mínimo 32 caracteres). Genere uno con: openssl rand -base64 48
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio-de-48-caracteres
# Tasas de cambio:
#   oficial = TRM del día (Superintendencia Financiera, datos.gov.co) para COP y Banco Central
#             Europeo para BRL, EUR, MXN…; se actualiza sola cada hora. Requiere internet.
#   fija    = valores de TRM_DESARROLLO / TASAS_DESARROLLO (para trabajar sin internet).
TASAS_PROVEEDOR=oficial
# Monedas sin fuente oficial automática (PEN, CLP, ARS…): unidades por 1 USD
TASAS_RESPALDO=PEN=3.75,CLP=950,ARS=1000,UYU=40
TRM_DESARROLLO=4000
CORS_ORIGINS=http://localhost:5173

# ---------- Web ----------
WEB_PORT=5173
