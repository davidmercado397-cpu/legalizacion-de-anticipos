{
  "name": "@viaticos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integracion": "vitest run --config vitest.integracion.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generar": "drizzle-kit generate",
    "db:migrar": "tsx --env-file-if-exists=../../.env src/database/cli.ts migrar",
    "db:sembrar": "tsx --env-file-if-exists=../../.env src/database/cli.ts sembrar",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@node-rs/argon2": "^2.2.2",
    "@viaticos/contracts": "workspace:*",
    "@viaticos/shared-kernel": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "exceljs": "4.4.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15"
  }
}
