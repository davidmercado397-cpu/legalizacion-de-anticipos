# Copiar a .env y completar. NUNCA subir el .env real al repositorio.
# Aquí solo van secretos, infraestructura y controles de seguridad base. Los parámetros funcionales
# (modelos de IA, plantillas de WhatsApp, umbrales, valores por defecto) están en la tabla
# system_settings y los cambia el superadmin por API (GET/PATCH /api/v1/settings).
APP_ENV=development              # development | staging | production
ENABLE_DOCS=true                 # false en producción (o proteger /docs)
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://gastos:gastos@localhost:5432/gastos
# En producción, roles separados (scripts/db_roles.sql): DATABASE_URL con gastos_app (sin DDL) y
# este con gastos_migrator, que aplica las migraciones al arrancar. Vacío = usa DATABASE_URL.
MIGRATION_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
# 32+ bytes aleatorios: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Verificación en dos pasos (MFA) ---
# Llave Fernet que cifra las semillas TOTP (obligatoria):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
MFA_REQUIRED_ROLES=   # roles que no usan la API sin MFA activo (vacío = nadie; para exigirlo: admin,accountant,treasury,superadmin)

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=           # cualquier texto aleatorio, el mismo configurado en Meta
WHATSAPP_APP_SECRET=             # App Secret de Meta (firma de los eventos); obligatorio fuera de desarrollo
WHATSAPP_ACCESS_TOKEN=           # token permanente de usuario del sistema
WHATSAPP_PHONE_NUMBER_ID=
# Llave privada del endpoint de los Flows (python -m scripts.flows_public_key --generar); su pública se registra en Meta
WHATSAPP_FLOWS_PRIVATE_KEY=
WHATSAPP_FLOWS_PRIVATE_KEY_PASSPHRASE=
GRAPH_API_VERSION=v24.0

# --- IA (OpenRouter) ---
OPENROUTER_API_KEY=

# --- Cloudflare R2 (obligatorio; en desarrollo, un bucket de desarrollo) ---
R2_ENDPOINT_URL=                 # https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Tasas de cambio (opcional: fuentes públicas sin llave; estos son los valores por defecto) ---
# TRM_API_URL=https://www.datos.gov.co/resource/32sa-8pi3.json
# ECB_API_URL=https://api.frankfurter.dev/v1
