{
  "name": "viaticos",
  "private": true,
  "version": "0.1.0",
  "description": "Legalización de anticipos de viaje: web React sobre la API Python (apps/api)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:web": "pnpm --filter @viaticos/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @viaticos/web lint",
    "docker:dev": "docker compose up --build --watch",
    "docker:bajar": "docker compose down",
    "docker:reiniciar-datos": "docker compose down -v"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
